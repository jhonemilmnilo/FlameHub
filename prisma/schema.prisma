// Prisma schema for Flame-Hub (PostgreSQL on Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id          String   @id // Corresponds to Supabase Auth UUID
  email       String?  @unique
  nickname    String?  @unique
  displayName String
  firstName   String?
  lastName    String?
  studentId   String?  @unique
  department  String?
  bio         String?
  avatarUrl   String?
  role        Role     @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("SystemSettings")
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   @unique // e.g. "otp:resend:email@school.edu" or "otp:verify:127.0.0.1"
  count      Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@map("RateLimits")
}



