// Prisma schema for Flame-Hub (PostgreSQL on Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id              String    @id // Corresponds to Supabase Auth UUID
  email           String?   @unique
  nickname        String?   @unique
  displayName     String
  firstName       String?
  lastName        String?
  studentId       String?   @unique
  department      String?
  bio             String?
  avatarUrl       String?
  role            Role      @default(STUDENT)
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 🔗 User Relations
  posts           Post[]
  likedPosts      LikedPost[]

  @@map("User")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("SystemSettings")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "otp:resend:email@school.edu"
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("RateLimits")
}

model DepartmentType {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "CITE", "CEA", "CMA", "CAHS", "CELA", "CCJE"
  name        String   // e.g. "College of Information Technology Education"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 🔗 Department Relations
  posts       Post[]

  @@map("DepartmentTypes")
}

// ==========================================
// 📰 POST / CONFESSION FEED MODEL
// ==========================================
model Post {
  id            String          @id @default(cuid())
  userId        String          // Foreign key to User (Author)
  departmentId  String?         // Foreign key to DepartmentType (e.g. CITE, CEA)
  content       String          @db.Text
  isAnonymous   Boolean         @default(false)
  likesCount    Int             @default(0)
  commentsCount Int             @default(0)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // 🔗 Relationships
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    DepartmentType? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  likedPosts    LikedPost[]

  // ⚡ Performance Query Indexes
  @@index([userId])
  @@index([departmentId])
  @@index([createdAt(sort: Desc)])
  @@index([isDeleted, createdAt(sort: Desc)])
  @@map("Posts")
}

// ==========================================
// ❤️ LIKED POST MODEL
// ==========================================
model LikedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  // 🔗 Relationships
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 🔒 Composite Unique Constraint & Performance Indexes
  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
  @@map("LikedPosts")
}
