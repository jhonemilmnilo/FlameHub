// Prisma schema for Flame-Hub (PostgreSQL on Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id              String    @id // Corresponds to Supabase Auth UUID
  email           String?   @unique
  nickname        String?   @unique
  displayName     String
  firstName       String?
  lastName        String?
  studentId       String?   @unique
  department      String?
  bio             String?
  avatarUrl       String?
  role            Role      @default(STUDENT)
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 🔗 User Relations
  posts           Post[]
  likedPosts      LikedPost[]
  savedPosts      SavedPost[]
  hiddenPosts     HiddenPost[]
  comments        Comment[]

  @@map("User")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("SystemSettings")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "otp:resend:email@school.edu"
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key, expiresAt])
  @@map("RateLimits")
}

// ==========================================
// 🏢 DEPARTMENT TYPE MODEL (e.g. CITE, CEA)
// ==========================================
model DepartmentType {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "CITE", "CEA", "CBA", "CHS", "CAS", "CCJ"
  name        String   // Full department name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 🔗 Relations
  posts       Post[]

  @@map("DepartmentTypes")
}

// ==========================================
// 📰 POST / CONFESSION FEED MODEL
// ==========================================
model Post {
  id            String          @id @default(cuid())
  userId        String          // Foreign key to User (Author)
  departmentId  String?         // Foreign key to DepartmentType (e.g. CITE, CEA)
  content       String          @db.Text
  isAnonymous   Boolean         @default(false)
  likesCount    Int             @default(0)
  commentsCount Int             @default(0)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // 🔗 Relationships
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    DepartmentType? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  likedPosts    LikedPost[]
  savedPosts    SavedPost[]
  hiddenPosts   HiddenPost[]
  comments      Comment[]

  // ⚡ Performance Query Indexes
  @@index([userId])
  @@index([departmentId])
  @@index([createdAt(sort: Desc)])
  @@index([isDeleted, createdAt(sort: Desc)])
  @@map("Posts")
}

// ==========================================
// 💬 COMMENT MODEL
// ==========================================
model Comment {
  id            String    @id @default(cuid())
  postId        String
  userId        String
  content       String    @db.Text
  isAnonymous   Boolean   @default(false)
  likesCount    Int       @default(0)
  commentCounts Int       @default(0)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 🔗 Relationships
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ⚡ Performance Query Indexes
  @@index([postId])
  @@index([userId])
  @@index([postId, isDeleted, createdAt(sort: Asc)])
  @@map("Comments")
}

// ==========================================
// ❤️ LIKED POST MODEL
// ==========================================
model LikedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  // 🔗 Relationships
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 🔒 Composite Unique Constraint & Performance Indexes
  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
  @@map("LikedPosts")
}

// ==========================================
// 📌 SAVED / BOOKMARKED POST MODEL
// ==========================================
model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  savedAt   DateTime @default(now())

  // 🔗 Relationships
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 🔒 Composite Unique Constraint & Performance Indexes
  @@unique([userId, postId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([postId])
  @@map("SavedPosts")
}

// ==========================================
// 👁️ HIDDEN POST MODEL (Per-User Feed Filter)
// ==========================================
model HiddenPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  hiddenAt  DateTime @default(now())

  // 🔗 Relationships with Cascading Deletions
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 🔒 Composite Unique Constraint & Performance Indexes
  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("HiddenPosts")
}
